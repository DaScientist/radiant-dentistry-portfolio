---
// Navbar.astro
const navLinks = [
  { name: "Services", href: "#services" },
  { name: "About Dr. Aziz", href: "#about" },
  { name: "Smile Gallery", href: "#results" },
  { name: "Clinic & Timings", href: "#clinic-info" },
];

const whatsappUrl =
  "https://wa.me/917984781751?text=Hello%20Dr.%20Aziz%20Sakerwala,%20I%20would%20like%20to%20schedule%20a%20consultation%20at%20Radiant%20Dentistry.";
---

<header
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-white/85 border-b border-[#C5A059]/15 transition-all duration-300"
  id="main-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo Area -->
      <a
        href="#"
        class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-[#C5A059] rounded-lg py-1 px-1.5"
        aria-label="Radiant Dentistry Home"
      >
        <div
          class="relative w-12 h-12 flex items-center justify-center shrink-0"
        >
          <img
            src="/RadiantDentistryLogoIcon.png"
            alt="Radiant Dentistry Golden & Silver Tooth Logo with Radiant Star"
            class="w-full h-full object-contain filter drop-shadow-[0_2px_8px_rgba(197,160,89,0.3)] group-hover:scale-105 transition-transform duration-300"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span
            class="font-serif tracking-[0.18em] text-lg sm:text-xl font-bold text-[#16181B] group-hover:text-[#C5A059] transition-colors leading-tight"
          >
            RADIANT
          </span>
          <span
            class="text-[10px] tracking-[0.26em] text-[#9A7836] uppercase font-semibold"
          >
            DENTISTRY
          </span>
          <span
            class="text-[9px] tracking-[0.16em] text-[#8E95A5] uppercase font-medium mt-0.5"
          >
            Dr. Aziz Sakerwala (M.D.S.)
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav
        class="hidden md:flex items-center gap-8"
        aria-label="Main Navigation"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-[#16181B]/80 hover:text-[#C5A059] transition-colors relative py-1 after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#C5A059] hover:after:w-full after:transition-all after:duration-300"
            >
              {link.name}
            </a>
          ))
        }
      </nav>

      <!-- Desktop Action Buttons -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="tel:+917984781751"
          class="flex items-center gap-2 text-xs font-semibold text-[#16181B] hover:text-[#C5A059] transition-colors py-2 px-3 rounded-lg hover:bg-[#C5A059]/5"
          aria-label="Call Clinic: +91 7984781751"
        >
          <svg
            class="w-4 h-4 text-[#C5A059]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          <span>+91 7984781751</span>
        </a>

        <button
          type="button"
          data-open-modal
          class="relative inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold tracking-wider uppercase text-white bg-gradient-to-r from-[#C5A059] to-[#B38E46] hover:from-[#B38E46] hover:to-[#9A7836] rounded-full shadow-sm hover:shadow-[0_0_20px_rgba(197,160,89,0.35)] transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-[#C5A059] focus:ring-offset-2"
        >
          <span>Book Consultation</span>
          <svg
            class="w-3.5 h-3.5 ml-2"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 md:hidden">
        <a
          href="tel:+917984781751"
          class="p-2 text-[#C5A059] bg-[#C5A059]/10 rounded-full"
          aria-label="Call clinic directly"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2.5 rounded-lg text-[#16181B] hover:text-[#C5A059] hover:bg-[#C5A059]/10 focus:outline-none focus:ring-2 focus:ring-[#C5A059]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle Navigation Menu"
        >
          <svg
            id="menu-icon-bars"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="menu-icon-close"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-[#C5A059]/20 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 transition-all duration-300 shadow-xl"
  >
    <div class="flex flex-col space-y-3">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-base font-medium text-[#16181B] hover:text-[#C5A059] px-3 py-2 rounded-md hover:bg-[#C5A059]/5 transition-colors"
          >
            {link.name}
          </a>
        ))
      }
      <div class="pt-3 border-t border-gray-100 flex flex-col gap-2.5">
        <a
          href="tel:+917984781751"
          class="flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl border border-[#C5A059]/30 text-sm font-semibold text-[#16181B] hover:bg-[#C5A059]/5"
        >
          <svg
            class="w-4 h-4 text-[#C5A059]"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path>
          </svg>
          Call: +91 7984781751
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-gradient-to-r from-[#C5A059] to-[#B38E46] text-white text-sm font-semibold shadow-md"
        >
          <span>Book Consultation on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle script with accessibility
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconBars = document.getElementById("menu-icon-bars");
  const iconClose = document.getElementById("menu-icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  if (toggleBtn && mobileMenu && iconBars && iconClose) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
      iconBars.classList.toggle("hidden");
      iconClose.classList.toggle("hidden");
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.add("hidden");
        iconBars.classList.remove("hidden");
        iconClose.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
