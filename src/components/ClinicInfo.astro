---
// ClinicInfo.astro
const clinicAddress = "4, Sikligar Society, Opp. Vinayak Hospital, Besides SBI, Outside Panigate, Vadodara - 390019";
const mapUrl = "https://www.google.com/maps/search/?api=1&query=Sikligar+Society+Opp+Vinayak+Hospital+Besides+SBI+Outside+Panigate+Vadodara+390019";
const phone = "+91 7984781751";
const phoneRaw = "+917984781751";
const instagram = "@azizjuzer";
const instagramUrl = "https://www.instagram.com/azizjuzer/";
---

<section id="clinic-info" class="py-20 md:py-28 bg-[#FAFAFB] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#C5A059]/10 text-[#9A7836] border border-[#C5A059]/30">
        Visit &amp; Contact
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[#16181B] tracking-tight">
        Clinic Location &amp; OPD Hours
      </h2>
      <p class="text-base sm:text-lg text-[#6B7280]">
        Strategically located in the heart of Vadodara with dedicated patient parking, serene sterilization zones, and morning &amp; evening consultation hours.
      </p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Bento Item 1: OPD Timings (5 cols on md) -->
      <div class="md:col-span-5 bg-white rounded-3xl p-7 sm:p-8 border border-[#C5A059]/25 shadow-sm flex flex-col justify-between relative overflow-hidden">
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <div class="w-11 h-11 rounded-xl bg-[#C5A059]/10 text-[#C5A059] flex items-center justify-center">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>

            <!-- Dynamic Live Status Indicator -->
            <span id="opd-live-status" class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Checking status...
            </span>
          </div>

          <div>
            <h3 class="font-serif text-2xl font-bold text-[#16181B] mb-1">OPD Schedule</h3>
            <p class="text-xs text-[#6B7280]">Monday through Saturday (Sunday by Prior Appointment)</p>
          </div>

          <!-- The Two Slot Boxes -->
          <div class="space-y-3">
            <div class="p-4 rounded-2xl bg-[#FAFAFB] border border-[#C5A059]/20 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-amber-100/70 text-amber-800">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-[#16181B]">Morning OPD</p>
                  <p class="text-[11px] text-[#6B7280]">Consultations &amp; Precision Surgeries</p>
                </div>
              </div>
              <span class="text-xs sm:text-sm font-bold text-[#9A7836] bg-white px-3 py-1.5 rounded-xl border border-[#C5A059]/20 shadow-xs">
                09:30 AM – 01:00 PM
              </span>
            </div>

            <div class="p-4 rounded-2xl bg-[#FAFAFB] border border-[#C5A059]/20 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-indigo-100/70 text-indigo-800">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-[#16181B]">Evening OPD</p>
                  <p class="text-[11px] text-[#6B7280]">Evening Smile Consultations</p>
                </div>
              </div>
              <span class="text-xs sm:text-sm font-bold text-[#9A7836] bg-white px-3 py-1.5 rounded-xl border border-[#C5A059]/20 shadow-xs">
