            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Live OPD Open/Closed status evaluator based on Indian Standard Time (IST)
  function updateOPDStatus() {
    const statusEl = document.getElementById('opd-live-status');
    if (!statusEl) return;

    // Current time in IST (UTC + 5:30)
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const istDate = new Date(utc + (3600000 * 5.5));

    const day = istDate.getDay(); // 0 is Sunday, 1 is Monday ... 6 is Saturday
    const hours = istDate.getHours();
    const minutes = istDate.getMinutes();
    const totalMinutes = hours * 60 + minutes;

    // Morning slot: 09:30 AM (570 mins) to 01:00 PM (780 mins)
    // Evening slot: 04:00 PM (960 mins) to 08:00 PM (1200 mins)
    const morningStart = 9 * 60 + 30; // 570
    const morningEnd = 13 * 60;       // 780
    const eveningStart = 16 * 60;     // 960
    const eveningEnd = 20 * 60;       // 1200

    if (day === 0) {
      // Sunday
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500"></span> Sunday: Prior Appointment Only`;
    } else if (totalMinutes >= morningStart && totalMinutes < morningEnd) {
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Open Now • Morning OPD until 01:00 PM`;
    } else if (totalMinutes >= eveningStart && totalMinutes < eveningEnd) {
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Open Now • Evening OPD until 08:00 PM`;
    } else if (totalMinutes < morningStart) {
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-gray-400"></span> Closed • Opens at 09:30 AM`;
    } else if (totalMinutes >= morningEnd && totalMinutes < eveningStart) {
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-gray-400"></span> Break • Opens at 04:00 PM`;
    } else {
      statusEl.className = "inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200";
      statusEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-gray-400"></span> Closed for Day • Opens tomorrow 09:30 AM`;
    }
  }

  updateOPDStatus();
  setInterval(updateOPDStatus, 60000);
</script>
