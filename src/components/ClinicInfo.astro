            <div class="p-3 rounded-xl bg-[#FAFAFB] border border-gray-100 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#C5A059]"></span>
              <span><strong>Adjoining:</strong> Besides State Bank of India (SBI)</span>
            </div>
          </div>
        </div>

        <!-- Google Maps Button -->
        <div class="pt-6 border-t border-gray-100 mt-6 flex flex-wrap items-center justify-between gap-4">
