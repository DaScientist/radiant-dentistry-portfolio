          </div>

          <div>
            <h3 class="font-serif text-2xl font-bold text-[#16181B] mb-2">Clinic Address</h3>
            <p class="text-base sm:text-lg text-[#16181B] font-medium leading-relaxed">
              4, Sikligar Society, Opp. Vinayak Hospital, <br class="hidden sm:inline" />
              Besides SBI, Outside Panigate, <br />
              <span class="text-[#C5A059] font-bold">Vadodara – 390019</span>, Gujarat, India
            </p>
          </div>

          <!-- Landmarks & Directions Note -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
