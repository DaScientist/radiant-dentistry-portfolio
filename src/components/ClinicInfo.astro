            </svg>
            <span>Get Directions on Google Maps</span>
          </a>

          <span class="text-xs text-[#6B7280]">
            Ample patient parking available
          </span>
        </div>
      </div>

      <!-- Bento Item 3: Direct Phone Card (4 cols) -->
      <div class="md:col-span-4 bg-white rounded-3xl p-6 border border-[#C5A059]/20 shadow-sm hover:border-[#C5A059] transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-[#C5A059]/10 text-[#C5A059] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-[#8E95A5] uppercase tracking-wider">Direct Clinic Line</span>
            <h4 class="font-serif text-xl font-bold text-[#16181B] mt-1">{phone}</h4>
            <p class="text-xs text-[#6B7280] mt-1">Direct telephone assistance for urgent appointments and patient inquiries.</p>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 mt-4">
          <a
            href={`tel:${phoneRaw}`}
            class="text-xs font-bold uppercase tracking-wider text-[#C5A059] hover:underline flex items-center gap-1.5"
          >
            <span>Dial Clinic Now</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Bento Item 4: WhatsApp Instant Scheduling (4 cols) -->
      <div class="md:col-span-4 bg-white rounded-3xl p-6 border border-[#C5A059]/20 shadow-sm hover:border-[#C5A059] transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.456 5.711 1.457h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-[#8E95A5] uppercase tracking-wider">Fast WhatsApp Connect</span>
            <h4 class="font-serif text-xl font-bold text-[#16181B] mt-1">Instant Chat</h4>
            <p class="text-xs text-[#6B7280] mt-1">Send a message directly to Dr. Aziz Sakerwala's desk for consultation scheduling.</p>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 mt-4">
          <a
            href="https://wa.me/917984781751?text=Hello%20Dr.%20Aziz%20Sakerwala,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Radiant%20Dentistry."
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold uppercase tracking-wider text-emerald-600 hover:underline flex items-center gap-1.5"
          >
            <span>Open WhatsApp Chat</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Bento Item 5: Instagram Spotlight (4 cols) -->
      <div class="md:col-span-4 bg-white rounded-3xl p-6 border border-[#C5A059]/20 shadow-sm hover:border-[#C5A059] transition-all flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-rose-500 to-purple-600 text-white flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-semibold text-[#8E95A5] uppercase tracking-wider">Clinical Case Stories</span>
            <h4 class="font-serif text-xl font-bold text-[#16181B] mt-1">{instagram}</h4>
            <p class="text-xs text-[#6B7280] mt-1">Follow Dr. Aziz on Instagram for live chairside updates and smile transformations.</p>
          </div>
        </div>
        <div class="pt-4 border-t border-gray-100 mt-4">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
