---
// Hero.astro
const whatsappPrefill = "https://wa.me/917984781751?text=Hello%20Dr.%20Aziz%20Sakerwala,%20I%20would%20like%20to%20book%20an%20appointment%20at%20Radiant%20Dentistry.";
---

<section class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden bg-gradient-to-b from-[#FAFAFB] via-white to-[#FAFAFB]">
  <!-- Ambient Gold and Silver Glow Accents -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-[#C5A059]/10 via-[#DFC89E]/5 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 -right-24 w-96 h-96 bg-[#8E95A5]/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-10 w-72 h-72 bg-[#C5A059]/8 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Dual CTAs (7 cols) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left">
        
        <!-- Luxury Accent Pill & Specialist Badges -->
        <div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#C5A059]/10 text-[#9A7836] border border-[#C5A059]/30">
            <span class="w-2 h-2 rounded-full bg-[#C5A059] animate-ping"></span>
            Super-Specialist Dental Care
          </span>

          <div class="flex items-center gap-1.5 bg-white shadow-sm border border-gray-200/80 px-2.5 py-1 rounded-full text-xs text-[#16181B] font-medium">
            <span class="font-bold text-[#C5A059]">B.D.S.</span>
            <span class="text-gray-300">•</span>
            <span class="font-bold text-[#C5A059]">M.D.S.</span>
            <span class="text-[#6B7280] hidden sm:inline">(Prosthodontics & Crown-Bridge)</span>
          </div>
        </div>

        <!-- High-Impact Main Headline -->
        <div class="space-y-3">
          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#16181B] leading-[1.12]">
            Precision Prosthodontics &amp; <span class="gold-gradient-text block sm:inline">Radiant Smile Design</span>
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-[#6B7280] max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
            Led by <strong class="text-[#16181B] font-semibold">Dr. Aziz Sakerwala</strong>, Radiant Dentistry delivers world-class smile restoration, dental implants, and full mouth rehabilitation with unmatched clinical perfection in Vadodara.
          </p>
        </div>

        <!-- Dual CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <button
            type="button"
            data-open-modal
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-sm font-semibold tracking-wider uppercase text-white bg-gradient-to-r from-[#C5A059] via-[#B38E46] to-[#9A7836] hover:brightness-110 rounded-full shadow-[0_10px_25px_-5px_rgba(197,160,89,0.4)] hover:shadow-[0_15px_30px_-5px_rgba(197,160,89,0.5)] transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#C5A059] focus:ring-offset-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Book an Appointment</span>
          </button>

          <a
            href="tel:+917984781751"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 text-sm font-semibold tracking-wider text-[#16181B] bg-white/80 hover:bg-white border border-[#C5A059]/30 hover:border-[#C5A059] rounded-full shadow-sm hover:shadow-md transition-all duration-300"
          >
            <svg class="w-4 h-4 text-[#C5A059]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>Call: +91 7984781751</span>
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="pt-6 border-t border-gray-200/70 grid grid-cols-2 sm:grid-cols-3 gap-4 text-left">
          <div class="flex items-start gap-2.5">
            <div class="p-1.5 rounded-lg bg-[#C5A059]/10 text-[#C5A059] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-[#16181B]">Digital X-Ray On-Site</p>
              <p class="text-[11px] text-[#6B7280]">Instant low-radiation scan</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5">
            <div class="p-1.5 rounded-lg bg-[#C5A059]/10 text-[#C5A059] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-[#16181B]">MDS Super-Specialist</p>
              <p class="text-[11px] text-[#6B7280]">Advanced Prosthodontics</p>
            </div>
          </div>

          <div class="col-span-2 sm:col-span-1 flex items-start gap-2.5">
            <div class="p-1.5 rounded-lg bg-[#C5A059]/10 text-[#C5A059] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-[#16181B]">Convenient Timings</p>
              <p class="text-[11px] text-[#6B7280]">Morning &amp; Evening Slots</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Anti-gravity Floating Aesthetic Hero Graphic (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Main Hero Frame with Pure White Luxury Card & Gold Border -->
          <div class="relative rounded-3xl overflow-hidden bg-white shadow-[0_20px_50px_rgba(22,24,27,0.08)] border border-[#C5A059]/25 p-3 group">
            
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-gray-100">
              <img
                src="/images/clinic_interior.jpg"
                alt="Radiant Dentistry Modern Luxury Clinical Operatory with State-of-the-Art Dental Suite"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="eager"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#16181B]/60 via-transparent to-transparent"></div>
              
              <!-- Bottom Inner Overlay -->
              <div class="absolute bottom-4 left-4 right-4 text-white flex items-center justify-between">
                <div>
                  <p class="text-xs uppercase tracking-widest text-[#DFC89E] font-semibold">State-of-the-Art Suite</p>
                  <p class="text-sm font-semibold font-serif">4, Sikligar Society, Panigate</p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-medium border border-white/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  Active OPD
                </span>
              </div>
            </div>

            <!-- Doctor Inset Badge with Doctor photo -->
            <div class="mt-3 p-3 rounded-xl bg-[#FAFAFB] border border-[#C5A059]/15 flex items-center gap-3">
              <img
                src="/images/dr_aziz.jpg"
                alt="Dr. Aziz Sakerwala B.D.S., M.D.S. Prosthodontics"
                class="w-12 h-12 rounded-full object-cover border-2 border-[#C5A059] shadow-sm shrink-0"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5">
                  <h3 class="text-sm font-bold text-[#16181B] truncate">Dr. Aziz Sakerwala</h3>
                  <svg class="w-4 h-4 text-[#C5A059] shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="text-xs text-[#6B7280] truncate">Consultant Prosthodontist &amp; Implantologist</p>
              </div>
            </div>

          </div>

          <!-- Anti-Gravity Floating Card 1: Specialist in Implants & Veneers -->
          <div class="absolute -top-6 -left-6 sm:-left-8 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl shadow-[0_15px_30px_rgba(22,24,27,0.12)] border border-[#C5A059]/30 flex items-center gap-3 animate-float-slow">
            <div class="w-11 h-11 rounded-xl bg-[#FAFAFB] border border-[#C5A059]/25 flex items-center justify-center p-1.5 shrink-0 shadow-sm">
              <img src="/images/radiant_tooth_mark.png" alt="Radiant Dentistry Emblem" class="w-full h-full object-contain filter drop-shadow-sm" />
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-[#9A7836] font-bold">Specialist Focus</span>
              <span class="block text-xs sm:text-sm font-bold text-[#16181B]">Implants &amp; Veneers</span>
            </div>
          </div>

          <!-- Anti-Gravity Floating Card 2: Full Mouth Rehabilitation -->
          <div class="absolute -bottom-6 -right-4 sm:-right-6 bg-white/95 backdrop-blur-md p-3.5 rounded-2xl shadow-[0_15px_30px_rgba(22,24,27,0.12)] border border-[#C5A059]/30 flex items-center gap-3 animate-float-delayed">
            <div class="w-10 h-10 rounded-xl bg-[#16181B] flex items-center justify-center text-[#C5A059] shadow-sm shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <span class="block text-[11px] uppercase tracking-wider text-[#6B7280] font-semibold">Clinical Guarantee</span>
              <span class="block text-xs sm:text-sm font-bold text-[#16181B]">Precision Occlusion</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
