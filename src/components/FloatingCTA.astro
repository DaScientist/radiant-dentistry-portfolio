---
// FloatingCTA.astro
const whatsappUrl = "https://wa.me/917984781751?text=Hello%20Dr.%20Aziz%20Sakerwala,%20I%20would%20like%20to%20inquire%20about%20a%20consultation%20at%20Radiant%20Dentistry.";
---

<aside class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3" aria-label="Quick Contact Actions">
  
  <!-- WhatsApp Floating Action -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center gap-2.5 px-4 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white shadow-[0_8px_25px_rgba(37,211,102,0.4)] hover:shadow-[0_12px_30px_rgba(37,211,102,0.5)] transition-all duration-300 transform hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-[#25D366] focus:ring-offset-2"
    aria-label="Chat on WhatsApp with Dr. Aziz Sakerwala"
  >
    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347m-5.421 7.403" />
    </svg>
    <span class="text-xs font-bold tracking-wide hidden sm:inline">WhatsApp Dr. Aziz</span>
  </a>

  <!-- Quick Floating Book Consultation / Call Pill for Mobile -->
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#C5A059]/30 p-3 flex items-center gap-2 shadow-[0_-5px_20px_rgba(0,0,0,0.06)]">
    <a
      href="tel:+917984781751"
      class="flex-1 py-3 px-2 rounded-xl border border-[#C5A059]/40 text-center text-xs font-bold text-[#16181B] flex items-center justify-center gap-1.5"
    >
      <svg class="w-4 h-4 text-[#C5A059]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Call Clinic</span>
    </a>

    <button
      type="button"
      data-open-modal
      class="flex-1 py-3 px-2 rounded-xl bg-gradient-to-r from-[#C5A059] to-[#B38E46] text-white text-center text-xs font-bold shadow-md flex items-center justify-center gap-1.5"
    >
      <span>Book Consultation</span>
    </button>
  </div>

</aside>
