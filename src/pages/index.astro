---
// index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import AboutDoctor from '../components/AboutDoctor.astro';
import ClinicInfo from '../components/ClinicInfo.astro';
import Footer from '../components/Footer.astro';
import AppointmentModal from '../components/AppointmentModal.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

const patientReviews = [
  {
    name: "Mehul Shah",
    location: "Alkapuri, Vadodara",
    treatment: "Full Mouth Rehabilitation & Implants",
    stars: 5,
    review: "Dr. Aziz Sakerwala is a true master in prosthodontics. I had severe chewing trouble and worn-down teeth for years. He meticulously planned every crown and implant. Today I can eat anything without pain. Truly world-class clinic!"
  },
  {
    name: "Pooja Varma",
    location: "Vasna Road, Vadodara",
    treatment: "Porcelain Veneers & Smile Makeover",
    stars: 5,
    review: "The aesthetic transformation of my front teeth is unbelievable! Dr. Aziz took high-resolution digital scans and designed veneers that match my face naturally. The staff is polite and the clinic is spotless and luxurious."
  },
  {
    name: "Farhan Pathan",
    location: "Panigate, Vadodara",
    treatment: "Dental Implants & Zirconia Bridge",
    stars: 5,
    review: "I was very nervous about getting a dental implant surgery, but Dr. Aziz explained every step clearly and the procedure was 100% painless. The digital X-rays right on the chair made diagnosis instant. Highly recommend Radiant Dentistry!"
  }
];

const clinicalStandards = [
  {
    title: "Class-B Autoclave Sterilization",
    desc: "Strict multi-tier hospital-grade autoclaving and 100% single-use disposable barriers for complete patient safety.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`
  },
  {
    title: "MDS Gold Standard Precision",
    desc: "Every crown, bridge, and implant is planned with sub-millimeter occlusion calculations to prevent fracture or jaw stress.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />`
  },
  {
    title: "Painless Anesthetic Protocols",
    desc: "Topical pre-numbing gels and micro-gauge delivery ensure treatments are gentle, serene, and stress-free.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`
  },
  {
    title: "Direct Specialist Access",
    desc: "Your consultations, treatments, and follow-ups are carried out personally by Dr. Aziz Sakerwala, not junior interns.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`
  }
];
---

<Layout
  title="Radiant Dentistry | Dr. Aziz Sakerwala | Specialist Prosthodontist & Implantologist Vadodara"
  description="Ultra-premium dental care in Vadodara by Dr. Aziz Sakerwala (BDS, MDS Prosthodontics). Specializing in Dental Implants, Full Mouth Rehabilitation, Porcelain Veneers, and Radiant Smile Design."
>
  <Navbar />
  
  <main id="main-content">
    <!-- Hero Section -->
    <Hero />

    <!-- Clinical Standards Strip -->
    <section class="py-12 bg-white border-y border-[#C5A059]/15">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {clinicalStandards.map((std) => (
            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-[#FAFAFB] border border-gray-100 hover:border-[#C5A059]/30 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-[#C5A059]/10 text-[#C5A059] flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" set:html={std.icon} />
              </div>
              <div class="space-y-1">
                <h3 class="text-xs sm:text-sm font-bold text-[#16181B]">{std.title}</h3>
                <p class="text-[11px] text-[#6B7280] leading-relaxed">{std.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <Services />

    <!-- Before & After Comparison Showcase -->
    <BeforeAfter />

    <!-- About Dr. Aziz Sakerwala Section -->
    <AboutDoctor />

    <!-- Patient Testimonials Section -->
    <section class="py-20 bg-white border-t border-gray-100 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#C5A059]/10 text-[#9A7836] border border-[#C5A059]/30">
            Patient Stories
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#16181B] tracking-tight">
            Loved by Patients Across Vadodara
          </h2>
          <p class="text-sm sm:text-base text-[#6B7280]">
            Hear from individuals who experienced radiant smile restorations, restored biting strength, and painless care at Radiant Dentistry.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {patientReviews.map((item) => (
            <div class="bg-[#FAFAFB] rounded-3xl p-7 border border-[#C5A059]/20 hover:border-[#C5A059] shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
              <div class="space-y-4">
                <div class="flex items-center gap-1 text-[#C5A059]">
                  {Array.from({ length: item.stars }).map(() => (
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <p class="text-xs sm:text-sm text-[#16181B]/80 leading-relaxed italic">
                  "{item.review}"
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-200/70">
                <p class="text-xs font-bold text-[#16181B]">{item.name}</p>
                <div class="flex items-center justify-between text-[11px] text-[#6B7280] mt-0.5">
                  <span>{item.location}</span>
                  <span class="text-[#C5A059] font-medium">{item.treatment}</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Google Reviews Badge Strip -->
        <div class="mt-12 text-center">
          <div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-white border border-[#C5A059]/30 shadow-sm text-xs text-[#16181B]">
            <span class="font-bold text-[#C5A059]">5.0 ★★★★★</span>
            <span class="text-gray-300">•</span>
            <span>Rated Excellent for Prosthodontics &amp; Implant Surgery in Vadodara</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Clinic Info & OPD Hours Bento Grid -->
    <ClinicInfo />

    <!-- Appointment Booking CTA Strip -->
    <section class="py-16 bg-gradient-to-br from-[#16181B] via-[#20232A] to-[#16181B] text-white relative overflow-hidden">
      <!-- Ambient gold glow -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(197,160,89,0.2),transparent_50%)]"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-6">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#C5A059]/20 text-[#DFC89E] border border-[#C5A059]/30">
          Transform Your Smile Today
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight max-w-3xl mx-auto leading-tight">
          Ready for a Healthy, Confident &amp; <span class="gold-shine-text">Radiant Smile?</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-300 max-w-2xl mx-auto">
          Consult directly with Dr. Aziz Sakerwala (BDS, MDS Prosthodontics) at Radiant Dentistry Vadodara.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <button
            type="button"
            data-open-modal
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-xs sm:text-sm font-semibold tracking-wider uppercase text-white bg-gradient-to-r from-[#C5A059] to-[#B38E46] hover:brightness-110 rounded-full shadow-lg transition-all duration-300"
          >
            <span>Book Your Consultation</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <a
            href="https://wa.me/917984781751?text=Hello%20Dr.%20Aziz%20Sakerwala,%20I%20would%20like%20to%20schedule%20a%20consultation."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 text-xs sm:text-sm font-semibold tracking-wider text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-full transition-all duration-300"
          >
            <span>Direct WhatsApp</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Clinic Footer -->
  <Footer />

  <!-- Interactive Appointment Modal Dialog -->
  <AppointmentModal />

  <!-- Floating Contact CTA Bar -->
  <FloatingCTA />
</Layout>
