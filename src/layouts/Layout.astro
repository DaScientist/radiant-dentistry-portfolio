---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Radiant Dentistry | Dr. Aziz Sakerwala | Specialist Prosthodontist & Implantologist Vadodara",
  description = "Experience precision prosthodontics, full mouth rehabilitation, dental implants & radiant smile design in Vadodara by Dr. Aziz Sakerwala (B.D.S., M.D.S. Prosthodontics). Book your consultation today.",
  image = "/images/clinic_interior.jpg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://radiantdentistry.in");

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "Radiant Dentistry",
  "alternateName": "Radiant Dentistry - Dr. Aziz Sakerwala (Prosthodontist & Implantologist)",
  "image": "https://radiantdentistry.in/images/clinic_interior.jpg",
  "logo": "https://radiantdentistry.in/favicon.svg",
  "telephone": "+917984781751",
  "url": "https://radiantdentistry.in",
  "priceRange": "₹₹",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "4, Sikligar Society, Opp. Vinayak Hospital, Besides SBI, Outside Panigate",
    "addressLocality": "Vadodara",
    "addressRegion": "Gujarat",
    "postalCode": "390019",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 22.3025,
    "longitude": 73.2084
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:30",
      "closes": "13:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "16:00",
      "closes": "20:00"
    }
  ],
  "medicalSpecialty": [
    "Prosthodontics",
    "Dental Implants",
    "Cosmetic Dentistry",
    "Full Mouth Rehabilitation",
    "Smile Design"
  ],
  "founder": {
    "@type": "Physician",
    "name": "Dr. Aziz Sakerwala",
    "honorificPrefix": "Dr.",
    "honorificSuffix": "B.D.S., M.D.S. (Prosthodontics)",
    "jobTitle": "Consultant Prosthodontist & Implantologist",
    "sameAs": "https://www.instagram.com/azizjuzer/"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#C5A059" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Prosthodontist in Vadodara, Best Dentist in Panigate Vadodara, Dr Aziz Sakerwala, Dental Implants Vadodara, Full Mouth Rehabilitation Vadodara, Smile Design Vadodara, Porcelain Veneers, Radiant Dentistry" />
    <meta name="author" content="Dr. Aziz Sakerwala" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Radiant Dentistry" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts: Plus Jakarta Sans (body) & Playfair Display / Cinzel (luxury serif accents) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Structured JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-[#FAFAFB] text-[#16181B] selection:bg-[#C5A059]/20 selection:text-[#16181B] antialiased">
    <slot />
  </body>
</html>
